# ClashBox MITM 模块配置（mihomo 内核专属）
# 京东去广告（移除开屏广告、精简我的页面产品推广）
# 对应规则文件：JD_remove_ads.json
# 作者：RuCu6, Maasea
# 说明：
#   - domains / capture-body / max-body-size 为文档定义的 MITM 配置字段。
#   - jddebug 诊断域名拦截已在 JD_remove_ads.json 的 httpRules 中（url-regex REJECT）。
#     如需在分流层拦截（http 80 端口，非 MITM 范围），可另加 mihomo 原生规则（见下方注释）。
domains:
  - api.m.jd.com

capture-body: true
max-body-size: 1048576

# 分流规则（mihomo 原生）建议：jddebug.com 为京东调试诊断域名，可整域 REJECT
# DOMAIN-SUFFIX, jddebug.com, REJECT
{
  "rewrites": [],
  "scripts": [
    {
      "phase": "http-response",
      "pattern": "^https://api\\.m\\.jd\\.com/client\\.action\\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)",
      "content": "https://kelee.one/Resource/JavaScript/JD/JD_remove_ads.js",
      "argument": ""
    }
  ],
  "bodyJq": [
    {
      "phase": "http-response-jq",
      "pattern": "^https://api\\.m\\.jd\\.com/client\\.action\\?functionId=basicConfig",
      "expr": "if ((getpath([\"data\",\"JDMessage\",\"socketmonitor\"]) // {}) | has(\"isSocketEstablishedAhead\")) then (setpath([\"data\",\"JDMessage\",\"socketmonitor\",\"isSocketEstablishedAhead\"]; 0)) else . end"
    },
    {
      "phase": "http-response-jq",
      "pattern": "^https://api\\.m\\.jd\\.com/client\\.action\\?functionId=basicConfig",
      "expr": "if ((getpath([\"data\",\"JDMessage\",\"socketmonitor\"]) // {}) | has(\"isSocketReport\")) then (setpath([\"data\",\"JDMessage\",\"socketmonitor\",\"isSocketReport\"]; 0)) else . end"
    },
    {
      "phase": "http-response-jq",
      "pattern": "^https://api\\.m\\.jd\\.com/client\\.action\\?functionId=basicConfig",
      "expr": "if ((getpath([\"data\",\"JDHttpToolKit\",\"httpdns\"]) // {}) | has(\"httpdns\")) then (setpath([\"data\",\"JDHttpToolKit\",\"httpdns\",\"httpdns\"]; 0)) else . end"
    }
  ],
  "locals": [
    {
      "pattern": "^https://api\\.m\\.jd\\.com/client\\.action\\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06])",
      "data": "{}",
      "status": 200,
      "headers": [
        "Content-Type:application/json"
      ]
    }
  ],
  "httpRules": [
    {
      "type": "url-regex",
      "pattern": "^http://\\w{32}\\.jddebug\\.com/diagnose\\?",
      "policy": "REJECT"
    }
  ]
}
